      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_ErrTriage" name="Send to Triage (System Error)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bRz3Yv8oq" />
            <uipath:input name="folderPath" type="string" value="=bindings.bTA6BYTNL" />
            <uipath:input name="_label" type="string" value="Triage-Queue" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"SpecificContent":{"type":"object"},"DueDate":{"type":"datetime"},"DeferDate":{"type":"datetime"},"Priority":{"type":"dropdown"},"Reference":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"SpecificContent":"=js:({\n  \"EmailID\": vars.response ? vars.response.ID : null,\n  \"FromEmail\": vars.response ? vars.response.From.Email : null,\n  \"Subject\": vars.response ? vars.response.Subject : null,\n  \"Category\": String(vars.category || \"\"),\n  \"Disposition\": \"SYSTEM_ERROR\",\n  \"FailedStep\": vars.errRouter ? \"Intake Router Agent\" : vars.errLoanExtract ? \"Loan Extractor Agent\" : vars.errMortgageExtract ? \"Mortgage Extractor Agent\" : vars.errCompliance ? \"Compliance Check Agent\" : vars.errRisk ? \"Risk Assessment Agent\" : vars.errRules ? \"Rules Risk Score\" : \"Unknown\",\n  \"ErrorMessage\": String((vars.errRouter || vars.errLoanExtract || vars.errMortgageExtract || vars.errCompliance || vars.errRisk || vars.errRules || {}).message || \"\"),\n  \"ErrorDetail\": String((vars.errRouter || vars.errLoanExtract || vars.errMortgageExtract || vars.errCompliance || vars.errRisk || vars.errRules || {}).detail || \"\")\n})","DueDate":null,"DeferDate":null,"Priority":"High","Reference":"=js:String(vars.response ? vars.response.ID : \"no-email\") + \"-ERR-\" + Date.now()"}]]></uipath:input>
          <uipath:output name="response" type="jsonSchema" source="=result" var="responseErrTriage" />
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="errorErrTriage" />
        </uipath:activity>
      </bpmn:extensionElements>
